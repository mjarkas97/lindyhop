# Copy to /srv/data/lindyhop/lindyhop.env on the server — outside the working
# tree, so a deploy's `git checkout -f` never touches it, and outside the data
# directory the container mounts.
#
# lindyhop-deploy passes this to `docker compose --env-file`, so these are
# compose variables: PORT picks the published host port, the other two are
# handed to the container.

# Public URL of the instance, exactly as the browser sees it. adapter-node
# compares this against the Origin header on every POST, so behind a reverse
# proxy it must be the external URL — not http://localhost:9930 — or logging in
# fails with "Cross-site POST form submissions are forbidden".
ORIGIN=https://lindyhop.example.com

# Host port, published on 127.0.0.1 only. Inside the container the app always
# listens on 3000.
PORT=9930

# Largest accepted upload, in bytes. adapter-node defaults to 512K, which
# rejects every real video. 1073741824 is 1 GiB.
BODY_SIZE_LIMIT=1073741824
