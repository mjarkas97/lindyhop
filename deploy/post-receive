#!/bin/bash
# Goes in the bare repo at /srv/repositories/lindyhop.git/hooks/post-receive
#
# `set -e` is the important part: without it a failed checkout does not stop the
# deploy, and the image gets rebuilt from a tree that was never updated. That is
# what happened on the deploy that produced "Permission denied" on the checkout
# and then went on to build and restart regardless.

set -euo pipefail

BARE_REPO=/srv/repositories/lindyhop.git
WORKING_DIR=/srv/vhosts/lindyhop
BRANCH=master

# The checkout consumes stdin (the oldrev/newrev/refname lines), so it has to
# read it directly rather than through a pipe that later steps also want.
sudo /srv/scripts/lindyhop-checkout "$BARE_REPO" "$WORKING_DIR" "$BRANCH"

# deploy builds the image and starts the container. There is no separate install
# or build step on the host any more — both happen inside the Dockerfile.
sudo /srv/scripts/lindyhop-deploy "$WORKING_DIR"

echo "Deploy finished."
