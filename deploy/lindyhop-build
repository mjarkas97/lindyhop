#!/bin/bash
# Install dependencies and build. Run by post-receive after the checkout.
#
#   lindyhop-build /srv/vhosts/lindyhop
#
# Replaces an `npm ci --omit=dev` + `npm run build` pair that could not work
# against this repo:
#
#   * it is a pnpm workspace. `pnpm-workspace.yaml` declares apps/*, and the root
#     package.json has no `workspaces` field, so npm cannot see apps/web at all.
#   * --omit=dev drops vite, svelte, adapter-node, sass and turbo, all of which
#     the build needs. Production-only dependencies cannot build this.

set -euo pipefail

PROJECT_DIR=$1

cd "$PROJECT_DIR"

# corepack ships with Node and pins the pnpm version from package.json.
# If it is unavailable, `npm i -g pnpm` instead.
corepack enable

echo "Node $(node -v), pnpm $(pnpm -v)"

# Full install, dev dependencies included: the build tools live there. The
# runtime needs almost nothing of it — adapter-node bundles the app and only
# @node-rs/argon2 is resolved from node_modules at run time.
echo "Installing dependencies..."
pnpm install --frozen-lockfile

echo "Building..."
pnpm --filter @lindyhop/web build

# Ownership and permissions, unchanged from the original script.
# 570 = owner r-x, group rwx, others none. The app never writes inside the
# project directory — the database and videos live under DATABASE_PATH and
# VIDEO_DIR, which must point outside it.
echo "Setting ownership and permissions..."
chown -R www-data:developers "$PROJECT_DIR"
chmod -R 570 "$PROJECT_DIR"

echo "Build complete."
