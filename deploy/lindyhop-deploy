#!/bin/bash
# Build the image and (re)start the container. Run by post-receive after the
# checkout.
#
#   lindyhop-deploy /srv/vhosts/lindyhop
#
# The host needs Docker and nothing else. Everything this used to depend on —
# a Node new enough for node:sqlite, corepack, a PM2 daemon owned by the right
# user — is pinned inside the image now.

set -euo pipefail

PROJECT_DIR=$1
PROJECT_NAME=lindyhop

# Deployment configuration lives outside the working directory on purpose:
# `git checkout -f` would otherwise clobber it on every deploy.
ENV_FILE=/srv/data/lindyhop/lindyhop.env

# The bind mount target. A subdirectory of /srv/data/lindyhop, so lindyhop.env
# next to it stays out of reach of the container.
DATA_DIR=/srv/data/lindyhop/data

if [ ! -f "$ENV_FILE" ]; then
  echo "Missing $ENV_FILE. See deploy/README.md." >&2
  exit 1
fi

set -a
# shellcheck source=/dev/null
. "$ENV_FILE"
set +a

# Fail here rather than after the app is already serving. ORIGIN is silent until
# someone tries to log in: adapter-node rejects every POST whose Origin does not
# match, so a wrong value looks like a broken login form.
: "${ORIGIN:?must be set in $ENV_FILE — the public URL, exactly as the browser sees it}"

# A bind mount ignores the Dockerfile's `chown node:node /data` — the host
# directory's ownership is what the container sees, and it runs as uid 1000.
# Without this the container boots and then fails its healthcheck on a database
# it cannot write.
echo "Preparing $DATA_DIR ..."
mkdir -p "$DATA_DIR/videos"
chown -R 1000:1000 "$DATA_DIR"

echo "Building and starting $PROJECT_NAME ..."

# --env-file rather than a service-level env_file: PORT is interpolated at the
# compose level to pick the published host port, which env_file cannot reach.
compose() {
  docker compose \
    --env-file "$ENV_FILE" \
    --file "$PROJECT_DIR/docker-compose.yml" \
    --project-name "$PROJECT_NAME" \
    "$@"
}

compose up -d --build --remove-orphans

# Layers from the previous build are unreferenced now and would accumulate on
# every deploy.
docker image prune -f >/dev/null

compose ps
echo "$PROJECT_NAME is running on ${BIND_ADDR:-127.0.0.1}:${PORT:-9930}, ORIGIN=$ORIGIN."
