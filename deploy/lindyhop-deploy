#!/bin/bash
# Build the image, snapshot the data, and (re)start the container. Run by
# post-receive after the checkout.
#
#   lindyhop-deploy /srv/vhosts/lindyhop
#
# The host needs Docker and nothing else. Everything this used to depend on —
# a Node new enough for node:sqlite, corepack, a PM2 daemon owned by the right
# user — is pinned inside the image now.

set -euo pipefail

PROJECT_DIR=$1
PROJECT_NAME=lindyhop

# Everything that is not in git lives here: the database, the videos and the
# deployment configuration. Deliberately outside the working directory, which
# `git checkout -f` overwrites on every deploy.
DATA_ROOT=/srv/data/lindyhop
ENV_FILE=$DATA_ROOT/lindyhop.env

# The bind mount target. A subdirectory, so lindyhop.env beside it stays out of
# reach of the container.
DATA_DIR=$DATA_ROOT/data

BACKUP_DIR=/srv/backups/$PROJECT_NAME
BACKUP_PATH=$BACKUP_DIR/$PROJECT_NAME-data-$(date +"%Y-%m-%d-%H%M%S").tar.gz

if [ ! -f "$ENV_FILE" ]; then
  echo "Missing $ENV_FILE. See deploy/README.md." >&2
  exit 1
fi

set -a
# shellcheck source=/dev/null
. "$ENV_FILE"
set +a

# Fail here rather than after the app is already serving. ORIGIN is silent until
# someone tries to log in: adapter-node rejects every POST whose Origin does not
# match, so a wrong value looks like a broken login form.
: "${ORIGIN:?must be set in $ENV_FILE — the public URL, exactly as the browser sees it}"

# A bind mount ignores the Dockerfile's `chown node:node /data` — the host
# directory's ownership is what the container sees, and it runs as uid 1000.
# Without this the container boots and then fails its healthcheck on a database
# it cannot write.
echo "Preparing $DATA_DIR ..."
mkdir -p "$DATA_DIR/videos"
chown -R 1000:1000 "$DATA_DIR"

# --env-file rather than a service-level env_file: PORT is interpolated at the
# compose level to pick the published host port, which env_file cannot reach.
compose() {
  docker compose \
    --env-file "$ENV_FILE" \
    --file "$PROJECT_DIR/docker-compose.yml" \
    --project-name "$PROJECT_NAME" \
    "$@"
}

# Build before stopping anything. This is the slow step and it has no effect on
# the data, so the old container goes on serving throughout.
echo "Building $PROJECT_NAME ..."
compose build

# The snapshot has to happen with the database quiescent: SQLite in WAL mode can
# be mid-write, and a tar of a live .db plus its -wal is not guaranteed to
# restore. A no-op on the first deploy, when there is nothing running yet.
echo "Stopping $PROJECT_NAME ..."
compose stop

# Taken before the new container starts, so this is the state to roll back to if
# a migration goes wrong. Same layout as the manual backup in README.md:
# ./data/lindyhop.db and ./lindyhop.env at the root of the archive.
echo "Snapshotting $DATA_ROOT to $BACKUP_PATH ..."
mkdir -p "$BACKUP_DIR"

# Password hashes and lindyhop.env end up in here. It used to hold source code and
# nothing else.
chmod 700 "$BACKUP_DIR"

# `set -e` would abort with the container still stopped, so a full disk would take
# the site down and leave it down. A failed snapshot should cancel the deploy, not
# the service.
if ! tar -czf "$BACKUP_PATH" -C "$DATA_ROOT" .; then
  echo "Snapshot failed. Restarting the previous container and stopping here." >&2
  rm -f "$BACKUP_PATH"
  compose start || true
  exit 1
fi

# Keep the seven most recent. The glob is deliberately narrower than
# "$PROJECT_NAME-"*: it must not match the old working-tree tarballs.
ls -1t "$BACKUP_DIR/$PROJECT_NAME-data-"*.tar.gz 2>/dev/null | tail -n +8 | xargs -r rm --

echo "Starting $PROJECT_NAME ..."
compose up -d --remove-orphans

# Layers from the previous build are unreferenced now and would accumulate on
# every deploy.
docker image prune -f >/dev/null

compose ps
echo "$PROJECT_NAME is running on ${BIND_ADDR:-127.0.0.1}:${PORT:-9930}, ORIGIN=$ORIGIN."

# These scripts are installed by hand, so a deploy can quietly run a version older
# than the tree it just checked out — including this very file. Last, not first:
# post-receive's output travels back over the push, and the tail is what you read.
for script in lindyhop-checkout lindyhop-deploy; do
  if ! cmp -s "/srv/scripts/$script" "$PROJECT_DIR/deploy/$script"; then
    echo "WARNING: /srv/scripts/$script is out of date." >&2
    echo "         sudo cp $PROJECT_DIR/deploy/$script /srv/scripts/" >&2
  fi
done
