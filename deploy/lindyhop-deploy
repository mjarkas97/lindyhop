#!/bin/bash
# Start or reload the app under PM2.
#
#   lindyhop-deploy /srv/vhosts/lindyhop
#
# The original ran `pm2 start npm -- run start`, which cannot work: the root
# package.json has no `start` script — only apps/web does. PM2 now runs the
# adapter-node output directly, which also drops an npm process from the tree.

set -euo pipefail

PROJECT_DIR=$1
PROJECT_NAME=lindyhop
ENTRY="$PROJECT_DIR/apps/web/dist/index.js"

# PM2 keeps its process list per user, under $HOME/.pm2. The apps run under
# www-data, and post-receive calls this script through sudo as root — so plain
# `pm2` here would talk to root's daemon, which knows nothing about them.
PM2_USER=www-data

# Deployment configuration lives outside the working directory on purpose:
# `git checkout -f` and the chown/chmod in lindyhop-helper would otherwise clobber
# it on every deploy.
ENV_FILE=/srv/data/lindyhop/lindyhop.env

if [ ! -f "$ENTRY" ]; then
  echo "No build at $ENTRY — did lindyhop-helper run?" >&2
  exit 1
fi

if [ ! -f "$ENV_FILE" ]; then
  echo "Missing $ENV_FILE. See deploy/README.md." >&2
  exit 1
fi

set -a
# shellcheck source=/dev/null
. "$ENV_FILE"
set +a

# Fail here rather than after the app is already serving. ORIGIN in particular is
# silent until someone tries to log in: adapter-node rejects every POST whose
# Origin does not match, so a wrong value looks like a broken login form.
: "${ORIGIN:?must be set in $ENV_FILE — the public URL, exactly as the browser sees it}"
: "${DATABASE_PATH:?must be set in $ENV_FILE}"
: "${VIDEO_DIR:?must be set in $ENV_FILE}"

# sudo clears the environment, so every variable is passed through explicitly.
run_pm2() {
  sudo -u "$PM2_USER" env \
    ORIGIN="$ORIGIN" \
    PORT="${PORT:-9930}" \
    HOST="${HOST:-0.0.0.0}" \
    DATABASE_PATH="$DATABASE_PATH" \
    VIDEO_DIR="$VIDEO_DIR" \
    BODY_SIZE_LIMIT="${BODY_SIZE_LIMIT:-1073741824}" \
    NODE_ENV=production \
    pm2 "$@"
}

echo "Restarting $PROJECT_NAME as $PM2_USER ..."

# Delete and recreate rather than reload. A reload re-runs whatever the existing
# entry was defined as — and the entry this replaces was `pm2 start npm -- run
# start`, which would come straight back. Recreating makes the deploy
# deterministic regardless of what is registered. There is no zero-downtime to
# lose: this is a single fork-mode process.
run_pm2 delete "$PROJECT_NAME" >/dev/null 2>&1 || true
run_pm2 start "$ENTRY" --name "$PROJECT_NAME" --update-env

# Persist the process list so it survives a reboot.
run_pm2 save

run_pm2 describe "$PROJECT_NAME" | grep -E 'status|script path|pid' || true
echo "$PROJECT_NAME is running."
