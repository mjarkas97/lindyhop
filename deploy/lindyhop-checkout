#!/bin/bash
# Check the pushed branch out into the working tree.
#
#   lindyhop-checkout /srv/repositories/lindyhop.git /srv/vhosts/lindyhop master
#
# It used to tar the working tree up first. That made sense when the tree was the
# thing that ran; now it is only a build context and every byte of it is already
# in the bare repo one directory over. The backup moved to lindyhop-deploy, which
# snapshots /srv/data/lindyhop instead — the part that is not in git.
#
# `set -euo pipefail` matters: without it a failed checkout still returned 0 and
# the deploy carried on to build and start a container from a tree that was never
# updated.

set -euo pipefail

BARE_REPO=$1
WORKING_DIR=$2
BRANCH=$3

mkdir -p "$WORKING_DIR"

# The hook's stdin is the oldrev/newrev/refname lines, and this loop consumes
# them — hence reading it directly rather than through a pipe.
while read -r oldrev newrev refname; do
  if [ "$refname" = "refs/heads/$BRANCH" ]; then
    echo "Checking out $BRANCH ..."
    git --work-tree="$WORKING_DIR" --git-dir="$BARE_REPO" checkout -f "$BRANCH"
  fi
done
